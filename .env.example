# Database configuration
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}


APP_ENV=
DB_INIT_ON_STARTUP=
SESSION_COOKIE_NAME=
CSRF_COOKIE_NAME=
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=
SESSION_TTL_SECONDS=
SESSION_REFRESH_SECONDS=
# How long an expired or revoked session row is kept before it is purged
SESSION_RETENTION_SECONDS=
AUTH_RATE_LIMIT_ATTEMPTS=
AUTH_RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_BLOCK_SECONDS=
# Empty = open in development, closed in production
REGISTRATION_ENABLED=
# Empty = CF-Connecting-IP is only trusted in production (infra_conventions §9)
TRUST_CF_CONNECTING_IP=
AUTH_TOKEN_PEPPER=


PASSWORD_PEPPER=
DEFAULT_USER_EMAIL=
DEFAULT_USER_USERNAME=
DEFAULT_USER_PASSWORD=

# Open Food Facts lookup by barcode (optional; https only, timeout 1-30 s)
OPEN_FOOD_FACTS_BASE_URL=
OPEN_FOOD_FACTS_TIMEOUT_SECONDS=

# In production it lives only in .env.migrations, read by the migrate service
MIGRATIONS_DATABASE_URL=
DB_RUNTIME_ROLE=

# Assistant for logging meals (Claude API). Empty = the assistant is disabled
ANTHROPIC_API_KEY=
# Optional; these are the defaults
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_EFFORT=high
ASSISTANT_TIMEOUT_SECONDS=60
# Whole message, under Cloudflare's ~100 s wait (20-95)
ASSISTANT_MESSAGE_BUDGET_SECONDS=75
ASSISTANT_MAX_TOOL_ROUNDS=8
