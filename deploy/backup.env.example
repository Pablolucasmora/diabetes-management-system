# Plantilla de /etc/daybetes/backup.env (root:root, chmod 600). Sin valores reales.

# Clave pública de age: el servidor cifra con ella; la privada nunca está aquí.
AGE_RECIPIENT=
BACKUP_REMOTE=r2:daybetes-backups

# URL de ping de Healthchecks.io. Es un secreto: quien la tenga puede
# marcar la copia como hecha.
HEALTHCHECK_URL=

# Remoto "r2" de rclone definido por variables de entorno (sin rclone.conf).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# Endpoint de jurisdicción UE: https://<account-id>.eu.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=
# El token solo puede escribir objetos, no crear buckets.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
