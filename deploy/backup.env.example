# Template for /etc/daybetes/backup.env (root:root, chmod 600). No real values.

# age public key: the server encrypts with it; the private key is never here.
AGE_RECIPIENT=
BACKUP_REMOTE=r2:daybetes-backups

# Healthchecks.io ping URL. It is a secret: whoever has it can mark the
# backup as done.
HEALTHCHECK_URL=

# rclone "r2" remote defined through environment variables (no rclone.conf).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# EU jurisdiction endpoint: https://<account-id>.eu.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=
# The token can only write objects, not create buckets.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
