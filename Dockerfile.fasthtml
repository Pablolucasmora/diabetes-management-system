# Lightweight Python base image, pinned by digest: a tag can move to another
# image (infra_conventions.md §10). Dependabot proposes the updates.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

# Do not write .pyc files and show logs in real time
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Working directory inside the container
WORKDIR /app

# System dependencies needed for PostgreSQL (psycopg)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*


# Copy and install the Python libraries
COPY requirements.txt .

# The lock lists every package, transitive ones included, with its hashes:
# pip refuses anything else.
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY . .

# Port used by FastHTML
EXPOSE 8000