# Lightweight Python base image, pinned by digest: a tag can move to another
# image (infra_conventions.md §10). Dependabot proposes the updates.
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

# Do not write .pyc files and show logs in real time
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Working directory inside the container
WORKDIR /app

# psycopg comes with its own libpq (psycopg[binary]): no compiler or system
# library in the image.
# The lock lists every package, transitive ones included, with its hashes:
# pip refuses anything else.
COPY requirements.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

# The app runs as an unprivileged user (audit H-19). The code stays owned by
# root, so the process cannot change it. The user has a home of its own: the
# VS Code dev container installs its server there (.devcontainer/), and in
# production nothing writes to it.
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --create-home --home-dir /home/app \
       --shell /usr/sbin/nologin app

COPY . .

USER app

# Port used by FastHTML
EXPOSE 8000
